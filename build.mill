import mill._
import mill.scalalib._
import mill.scalanativelib._

trait CommonModule extends ScalaModule {
  def scalaVersion = "3.9.0"
}

// Core module: Pure ELM business logic (Model, Msg, Update)
// No UI dependencies - can be used by layoutz, Tyrian, or any ELM-based frontend
object core extends CommonModule {

  def mvnDeps = Seq(
    mvn"com.softwaremill.quicklens::quicklens::1.9.15"
  )

  object test extends ScalaTests with TestModule.ScalaTest {
    def mvnDeps = Seq(
      mvn"org.scalatest::scalatest::3.2.20"
    )
  }
}

// App module: Presentation layer using layoutz (TUI)
// Depends on core for business logic
// Future: Add Tyrian+Electron for Desktop app
object app extends CommonModule {

  def moduleDeps = Seq(core)

  def mvnDeps = Seq(
    mvn"xyz.matthieucourt::layoutz::0.8.0",
    mvn"io.github.takapi327::ldbc-connector::0.8.0"
  )

  object test extends ScalaTests with TestModule.ScalaTest {
    def mvnDeps = Seq(
      mvn"org.scalatest::scalatest::3.2.20"
    )
  }
}

// Native binary of the TUI: core + app sources compiled with Scala Native, no JVM needed.
// Build with `mill native.nativeLink`; the binary lands in out/native/nativeLink.dest/out
object native extends CommonModule with ScalaNativeModule {
  def scalaNativeVersion = "0.5.12"
  def sources            = Task { core.sources() ++ app.sources() }
  def mvnDeps            = Task { core.mvnDeps() ++ app.mvnDeps() }
  def mainClass          = Some("com.w47s0n.app.tui.Main")
  // Release builds on macOS link libcrypto.a statically so the binary doesn't need Homebrew's openssl
  def nativeLinkingOptions = Task {
    super.nativeLinkingOptions() ++
      Task.env.get("OPENSSL_STATIC_LIB").toSeq.flatMap(lib => Seq(lib, "-Wl,-dead_strip_dylibs"))
  }
}
